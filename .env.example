# Required: API key from https://console.mistral.ai (the agent, speech and indexing)
MISTRAL_API_KEY=
# Required: local database password
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://selecta:${POSTGRES_PASSWORD}@localhost:5432/selecta

# Optional: your Discogs collection. Personal access token from
# https://www.discogs.com/settings/developers (without it, use examples/collection.json)
DISCOGS_TOKEN=

# Optional: a Subsonic-compatible music server such as Navidrome, and a non-admin user.
# Leave NAVIDROME_URL empty to pick records without playing them.
NAVIDROME_URL=
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# Optional: web lookups about records. Keys from https://app.tavily.com and
# https://dashboard.cohere.com
TAVILY_API_KEY=
COHERE_API_KEY=
